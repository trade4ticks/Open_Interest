# --- Postgres (VPS) ----------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=open_interest
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio

# --- ThetaData ---------------------------------------------------------------
# Same primary terminal as the SPX project (Tailscale-reachable on the VPS).
THETADATA_BASE_URL=http://100.76.94.99:25503

# --- Parquet storage for raw OI ---------------------------------------------
# Daily OI rows are written to {OI_RAW_DIR}/{ticker}/{year}.parquet.
# On the VPS we keep all bulk data under /data so it sits outside the project
# checkout. (If unset, the code falls back to ./data/oi_raw inside the project,
# which is fine for a fresh local checkout but not for the VPS.)
OI_RAW_DIR=/data/oi_raw

# --- SPX / SPXW index options (fetch_spx_options.py) ------------------------
# Must NOT be inside OI_RAW_DIR — that directory's listing is the 120-ticker
# universe. Raw OI: {SPX_OI_RAW_DIR}/{root}/{year}.parquet; raw trade-based
# EOD volume: {SPX_VOLUME_DIR}/{root}/{year}.parquet.
SPX_OI_RAW_DIR=/data/spx_oi_raw
SPX_VOLUME_DIR=/data/spx_volume_eod

# --- Polygon.io / Massive (1-minute equity bars) ----------------------------
# Stocks Developer plan. Paid plans are "unlimited" requests; vendor guidance
# is to stay under 100 req/s to avoid fair-use throttling.
POLYGON_API_KEY=your_key_here
# POLYGON_BASE_URL=https://api.polygon.io

# 1-minute equity bars: {EQUITY_1MIN_DIR}/{ticker}/{year}.parquet
EQUITY_1MIN_DIR=/data/equity_1min

